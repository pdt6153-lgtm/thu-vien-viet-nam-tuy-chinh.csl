<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="vi-VN">
  <info>
    <title>Thư viện Việt Nam - kiểu số tùy chỉnh</title>
    <id>http://www.zotero.org/styles/thu-vien-viet-nam-tuy-chinh</id>
    <link href="http://www.zotero.org/styles/thu-vien-viet-nam-tuy-chinh" rel="self"/>
    <author>
      <name>Microsoft 365 Copilot</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Kiểu trích dẫn số theo mẫu sách, sách dịch, tạp chí, hội thảo, luận án/luận văn và tài liệu Internet.</summary>
    <updated>2026-09-28T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="vi">
    <terms>
      <term name="and">và</term>
      <term name="et-al">và cộng sự</term>
      <term name="accessed">truy cập ngày</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name form="long" initialize="false" name-as-sort-order="all" sort-separator=" " delimiter=", " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued" prefix=" (" suffix=")">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="author-year">
    <group delimiter="">
      <text macro="author"/>
      <text macro="year"/>
    </group>
  </macro>

  <macro name="pages">
    <text variable="page"/>
  </macro>

  <macro name="translated-book">
    <group delimiter=". ">
      <text macro="author-year"/>
      <text variable="title" font-style="italic"/>
      <group prefix="(" suffix=")" delimiter=", ">
        <group delimiter=" ">
          <names variable="translator">
            <name form="long" initialize="false" name-as-sort-order="all" sort-separator=" " delimiter=", "/>
          </names>
          <text value="dịch"/>
        </group>
        <group delimiter=" ">
          <text value="dịch từ tiếng"/>
          <text variable="language"/>
        </group>
      </group>
      <text variable="volume" prefix="Tập "/>
      <group delimiter=", ">
        <text variable="publisher"/>
        <text variable="publisher-place"/>
        <text macro="pages"/>
      </group>
    </group>
  </macro>

  <macro name="book">
    <group delimiter=". ">
      <text macro="author-year"/>
      <text variable="title" font-style="italic"/>
      <text variable="volume" prefix="Tập "/>
      <group delimiter=", ">
        <text variable="publisher"/>
        <text variable="publisher-place"/>
        <text macro="pages"/>
      </group>
    </group>
  </macro>

  <macro name="journal-article">
    <group delimiter=". ">
      <text macro="author-year"/>
      <text variable="title"/>
      <text variable="container-title" font-style="italic"/>
      <group delimiter=", ">
        <text variable="volume" prefix="Tập "/>
        <text variable="issue" prefix="Số "/>
        <text macro="pages"/>
      </group>
    </group>
  </macro>

  <macro name="conference-paper">
    <group delimiter=". ">
      <text macro="author-year"/>
      <text variable="title"/>
      <text variable="container-title" font-style="italic"/>
      <group delimiter=", ">
        <text variable="event-place"/>
        <date variable="event-date">
          <date-part name="day" suffix="/"/>
          <date-part name="month" form="numeric" suffix="/"/>
          <date-part name="year"/>
        </date>
        <text macro="pages"/>
      </group>
    </group>
  </macro>

  <macro name="thesis">
    <group delimiter=". ">
      <text macro="author-year"/>
      <text variable="title" font-style="italic"/>
      <group delimiter=", ">
        <text variable="genre"/>
        <text variable="publisher"/>
        <text variable="publisher-place"/>
      </group>
    </group>
  </macro>

  <macro name="web">
    <group delimiter=". ">
      <text macro="author-year"/>
      <text variable="title" font-style="italic"/>
      <text variable="URL"/>
      <date variable="accessed" prefix="(" suffix=")">
        <text term="accessed" suffix=" "/>
        <date-part name="day" suffix="/"/>
        <date-part name="month" form="numeric" suffix="/"/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography et-al-min="7" et-al-use-first="6" entry-spacing="0" line-spacing="1">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]. "/>
      <choose>
        <if type="book" variable="translator" match="all">
          <text macro="translated-book"/>
        </if>
        <else-if type="book chapter" match="any">
          <text macro="book"/>
        </else-if>
        <else-if type="article-journal article-magazine article-newspaper" match="any">
          <text macro="journal-article"/>
        </else-if>
        <else-if type="paper-conference" match="any">
          <text macro="conference-paper"/>
        </else-if>
        <else-if type="thesis" match="any">
          <text macro="thesis"/>
        </else-if>
        <else-if type="webpage post post-weblog" match="any">
          <text macro="web"/>
        </else-if>
        <else>
          <text macro="book"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
